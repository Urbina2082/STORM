---
// Puedes ajustar aquí tus datos de contacto
const contactInfo = {
  facebook: "https://www.facebook.com/profile.php?id=61554842440621&locale=es_LA",
  instagram: "https://www.instagram.com/stormenterpise/",
  tiktok: "https://www.tiktok.com/@storm_enterprise?is_from_webapp=1&sender_device=pc",
  email: "stormenterpise@gmail.com",
  phone: "+52 861 126 81 48",
  phoneClean: "+528611268148",
};

import InitSection from "../components/Init-Section.astro";
---

<div class="social-section">
  <!-- Título principal estilo Storm -->
  <InitSection
    Section="REDES SOCIALES"
    title="Conéctate con nosotros"
   />

  <div class="cards-grid">
    <!-- Tarjeta: Facebook -->
    <a
      href={contactInfo.facebook}
      target="_blank"
      rel="noopener noreferrer"
      class="storm-card"
    >
      <div class="icon-badge">
        <svg class="icon" fill="currentColor" viewBox="0 0 24 24">
          <path
            d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
          ></path>
        </svg>
      </div>
      <div class="card-content">
        <h3 class="card-title">Facebook</h3>
        <p class="card-desc">
          Noticias, actualizaciones y proyectos recientes.
        </p>
      </div>
    </a>

    <!-- Tarjeta: Instagram -->
    <a
      href={contactInfo.instagram}
      target="_blank"
      rel="noopener noreferrer"
      class="storm-card"
    >
      <div class="icon-badge">
        <svg class="icon" fill="currentColor" viewBox="0 0 24 24">
          <path
            d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
          ></path>
        </svg>
      </div>
      <div class="card-content">
        <h3 class="card-title">Instagram</h3>
        <p class="card-desc">Contenido visual y detrás de cámaras.</p>
      </div>
    </a>

    <!-- Tarjeta: TikTok -->
    <a
      href={contactInfo.tiktok}
      target="_blank"
      rel="noopener noreferrer"
      class="storm-card"
    >
      <div class="icon-badge">
        <svg class="icon" fill="currentColor" viewBox="0 0 24 24">
          <path
            d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.82.57-1.31 1.56-1.28 2.56.02 1.04.59 2.01 1.49 2.54.91.54 2.09.58 3.03.1.84-.42 1.43-1.25 1.55-2.18.06-1.92.02-3.84.03-5.76V.02z"
          ></path>
        </svg>
      </div>
      <div class="card-content">
        <h3 class="card-title">TikTok</h3>
        <p class="card-desc">Videos cortos, consejos y contenido rápido.</p>
      </div>
    </a>

    <!-- Tarjeta: Correo Electrónico -->
    <a href={`mailto:${contactInfo.email}`} class="storm-card">
      <div class="icon-badge">
        <svg
          class="icon-stroke"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
          ></path>
        </svg>
      </div>
      <div class="card-content">
        <h3 class="card-title">Correo</h3>
        <p class="card-desc">{contactInfo.email}</p>
      </div>
    </a>

    <!-- Tarjeta: Teléfono -->
    <a href={`tel:${contactInfo.phoneClean}`} class="storm-card">
      <div class="icon-badge">
        <svg
          class="icon-stroke"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
          ></path>
        </svg>
      </div>
      <div class="card-content">
        <h3 class="card-title">Teléfono</h3>
        <p class="card-desc">{contactInfo.phone}</p>
      </div>
    </a>
  </div>
</div>

<style>
  /* Variables extraídas del diseño */
  :root {
    --navy-blue: #0b326f;
    --navy-hover: #124089;
    --text-title: #0a2540;
    --text-body: #425466;
    --border-color: #e6eef8;
    --card-bg: #ffffff;
    --shadow-soft: 0 10px 30px -10px rgba(11, 50, 111, 0.08);
    --shadow-hover: 0 18px 40px -12px rgba(11, 50, 111, 0.16);
  }

  .social-section {
    width: 100%;
    max-width: 72rem;
    margin: 0 auto;
    padding: 2rem 1rem;
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      sans-serif;
    box-sizing: border-box;
  }

  .main-heading {
    font-size: 1.875rem;
    font-weight: 800;
    color: var(--text-title);
    text-align: center;
    margin-bottom: 2rem;
    letter-spacing: -0.02em;
  }

  /* Grid Responsivo estilo tarjetas de Storm */
  .cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  /* Estilo base de cada tarjeta */
  .storm-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 1.75rem 1.5rem;
    background-color: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 1.5rem; /* Bordes marcadamente redondeados como en la imagen */
    text-decoration: none;
    box-shadow: var(--shadow-soft);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .storm-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
    border-color: rgba(11, 50, 111, 0.2);
  }

  /* Círculo con icono en azul marino */
  .icon-badge {
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 0.875rem; /* O usa 50% si prefieres círculos perfectos */
    background-color: var(--navy-blue);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
    transition:
      background-color 0.3s ease,
      transform 0.3s ease;
  }

  .storm-card:hover .icon-badge {
    background-color: var(--navy-hover);
    transform: scale(1.05);
  }

  .icon {
    width: 1.5rem;
    height: 1.5rem;
  }

  .icon-stroke {
    width: 1.5rem;
    height: 1.5rem;
  }

  /* Tipografía */
  .card-content {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .card-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text-title);
    margin: 0;
    line-height: 1.3;
  }

  .card-desc {
    font-size: 0.875rem;
    color: var(--text-body);
    margin: 0;
    line-height: 1.5;
    word-break: break-word;
  }

  /* Adaptabilidad a Tablets y Desktops */
  @media (min-width: 640px) {
    .cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .cards-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    /* Hace que la última fila se distribuya limpiamente si son 5 elementos */
    .storm-card:nth-child(4),
    .storm-card:nth-child(5) {
      grid-column: span 1;
    }
  }
</style>
